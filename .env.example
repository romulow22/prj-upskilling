#==============================================================
# Configuração do deploy.sh e do destroy.sh (modelo)
#
#   cp .env.example .env && chmod 600 .env
#   # preencha as credenciais e o e-mail
#   /caminho/para/prj-upskilling/deploy.sh      # de qualquer diretório
#
# Os scripts leem automaticamente o arquivo .env da pasta deles.
# Para usar outro arquivo: ENV_FILE=/caminho/upskilling.env ./deploy.sh
#
# NUNCA versione o .env: ele contém a secret access key (já está no .gitignore).
#
# Formato: CHAVE=valor, sem espaços ao redor do "=". Nenhum comando é
# executado e não há expansão de variáveis ($HOME, ~ etc.).
# Variáveis já definidas no ambiente (ex.: EMAIL=x ./deploy.sh) têm prioridade.
#==============================================================

#--------------------------------------------------------------
# Credenciais do usuário de serviço (IAM > Users > Security credentials)
#--------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=substitua-pela-secret-access-key
# Somente para credenciais temporárias (STS / assume-role):
# AWS_SESSION_TOKEN=

#--------------------------------------------------------------
# AWS CLI (comandos manuais do README; os scripts usam REGION)
#--------------------------------------------------------------
AWS_REGION=sa-east-1
AWS_DEFAULT_REGION=sa-east-1
# Vazio = sem paginador (less) na saída da AWS CLI
AWS_PAGER=
# Rede corporativa com proxy ou inspeção TLS:
# HTTPS_PROXY=http://proxy.empresa.com.br:8080
# AWS_CA_BUNDLE=/caminho/para/ca-corporativa.pem

#--------------------------------------------------------------
# Deploy
#--------------------------------------------------------------
REGION=sa-east-1
# Obrigatório nas etapas monitoramento e custos
EMAIL=romuloass@hotmail.com
# Nome global no S3; o bucket precisa estar na mesma região de REGION
BUCKET=projeto-upskilling

# Opcionais (valores padrão dos scripts):
# SSH_CIDR=200.10.20.30/32       # padrão: IP público detectado + /32
# EC2_MODELO=t3.medium           # t3.micro | t3.small | t3.medium | t3.large
# NOME_INSTANCIA=codeserver2
# KEY_NAME=code-server           # chave privada salva em ~/<KEY_NAME>.pem
# ORCAMENTO_USD=50
# PROJETO=projeto-upskilling
# AMBIENTE=dev
# RESPONSAVEL=c153824
# ATUALIZAR_AMI=nao              # "sim" substitui a instância EC2
